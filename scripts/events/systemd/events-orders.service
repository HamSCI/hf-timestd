[Unit]
Description=Turn the GOES flare list into event orders (wd30)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=wsprdaemon
Nice=19
IOSchedulingClass=idle
# The code sits outside every station's rrsync root.
ExecStart=/usr/bin/python3 /home/wsprdaemon/hamsci-events/events_server.py orders \
    --stations /home/wsprdaemon/hamsci-events/stations.json \
    --out /srv/wd_data/events/orders.json \
    --incoming /srv/wd_data/events/incoming
