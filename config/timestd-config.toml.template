# hf-timestd Configuration Template
# Copy this to timestd-config.toml and customize for your station
#
# REQUIRED: Update all values marked with <YOUR_...>

[station]
callsign = "<YOUR_CALLSIGN>"           # e.g., W1ABC
grid_square = "<YOUR_GRID>"            # e.g., FN31pr42ab (optional if latitude/longitude are provided)
id = "<YOUR_STATION_ID>"               # e.g., S000001
instrument_id = "<YOUR_INSTRUMENT_ID>" # e.g., 172
description = "<YOUR_DESCRIPTION>"     # e.g., RX888 MkII with resonant dipole
latitude = 0.0                          # Your latitude in decimal degrees (optional if grid_square is provided)
longitude = 0.0                         # Your longitude in decimal degrees (optional if grid_square is provided)

[ka9q]
# REQUIRED: the mDNS control/status multicast name of the radiod to
# consume from.  Discover available radiods on the LAN with:
#   hf-timestd discover           (lists radiod hostnames + channels)
#   avahi-browse -rt _ka9q-ctl._udp   (raw discovery)
# Examples: "bee1-status.local", "hf-status.local".  Leave the
# placeholder unchanged to make the daemon refuse to start until
# the operator edits this file.
status = "<YOUR_RADIOD_STATUS>"
auto_create_channels = true
# Data source mode: "radiod" (single antenna, 9 channels) or "phase-engine" (beamformed, 17 channels)
source = "radiod"

[recorder]
# engine = "phase-engine" # Set to phase-engine to enable automatic multi-station channel expansion
engine = "radiod"

# Data root (auto-created).  The legacy test/production "mode" toggle was
# removed — it defaulted to /tmp and silently broke real recorders.
production_data_root = "/var/lib/timestd"

# Recording parameters
recording_interval = 60
continuous = true
blocktime_ms = 20
max_gap_seconds = 60
storage_quota = "80%"

# Resource guardian eviction policy (hf-timestd#31).  At >=95% disk the
# guardian PAUSES writes and alerts immediately, but deletes nothing until the
# pressure PERSISTS past evict_grace_sec — a transient spike costs no data.
# Then it frees the smallest regenerable unit first (phase2 HDF5, products,
# vtec, upload/data), oldest first, one at a time, down to evict_low_water_percent;
# raw IQ is the last resort, a whole day at a time.  A guardian-event.json is
# written under <data_root>/state for the fleet board to read.
evict_policy = "auto"              # "auto" (evict after grace) | "alert_only" (never delete)
evict_grace_sec = 600              # >=95% must persist this long before any eviction
evict_low_water_percent = 90       # evict just enough to get back under this

# Compression: 'none', 'zstd', or 'lz4' - reduces disk I/O by ~2-3x
compression = "zstd"
compression_level = 3

# Raw IQ file chunk duration in seconds.  600 (10 min) reduces filesystem
# overhead 10x vs the legacy 60s cadence and improves compression ratio.
# Values must divide evenly into 3600.  Common choices: 60, 300, 600, 900.
file_duration_sec = 600

# Digital RF HDF5 output (uses significant storage ~1.5GB/day/channel)
save_digital_rf = false

# Tiered Storage: Use /dev/shm (RAM) for hot buffer, disk for cold storage
#
# Two independent RAM budgets ADD UP — keep their sum well under the
# systemd MemoryMax (defaults to 6 G in our unit file).  Cgroup memory
# accounting also double-counts tmpfs-backed scratch, so the effective
# ceiling is (tiered_ram_percent + ring_ram_percent) × available_RAM
# + ~1 G tmpfs double-count + ~0.5 G Python heap.  10 % + 10 % is a
# safe default on hosts with 14 G+ available; raise both together if
# you also raise MemoryMax.
tiered_storage = true
hot_buffer_root = "/dev/shm/timestd"
tiered_ram_percent = 10
ring_ram_percent = 10

# Channel defaults (applied to all channel groups unless overridden per-group)
[recorder.channel_defaults]
preset = "iq"
sample_rate = 24000
agc = 0
gain = 0
encoding = "F32"

# === Channel Groups ===
# --- timestd: full IQ archive channels for metrology and physics analysis ---
[recorder.channel_group.timestd]
preset = "iq"
sample_rate = 24000
agc = 0
gain = 0
encoding = "F32"
archive = true

[[recorder.channel_group.timestd.channels]]
frequency_hz = 2500000
description = "SHARED_2500"

[[recorder.channel_group.timestd.channels]]
frequency_hz = 5000000
description = "SHARED_5000"

[[recorder.channel_group.timestd.channels]]
frequency_hz = 10000000
description = "SHARED_10000"

[[recorder.channel_group.timestd.channels]]
frequency_hz = 15000000
description = "SHARED_15000"

[[recorder.channel_group.timestd.channels]]
frequency_hz = 20000000
description = "WWV_20000"

[[recorder.channel_group.timestd.channels]]
frequency_hz = 25000000
description = "WWV_25000"

# CHU (NRC Ottawa) ceased transmitting in 2026.  Its channels, FSK decoder,
# coarse-time producer and the bootstrap coordinator left the code on
# 2026-09-04; archived CHU data stays readable through hamsci_dsp.stations.

# WWVB (60 kHz LF) — NIST Fort Collins, added to offset the loss of CHU.
# See docs/WWVB-INTEGRATION.md.  A dedicated in-process consumer in the
# core-recorder provisions the 60 kHz channel, decodes the phase-modulated
# time code, and (optionally) feeds the Fusion source pool.  No archive.
# =============================================================================
[wwvb]
enabled = false                 # master switch for the WWVB consumer + decode loop
frequency_hz = 60000
sample_rate = 4000              # NARROW ON PURPOSE -- do not widen.  WWVB is a
                                # 1 bit/s code on a 60 kHz carrier; extra
                                # bandwidth admits only noise.  Measured on
                                # AC0G-B4 2026-08-18/19, same antenna and site,
                                # this value alone: 24 kHz -> 1 frame in 2758
                                # passes; 4 kHz -> 17 in 1533 (30x), and
                                # seconds-detected 29/90 -> 89/90.  A too-wide
                                # channel fails silently -- no error, just no
                                # decodes.  See tests/unit/test_wwvb_channel_width.py
window_s = 90.0                 # rolling decode-buffer length (s)
decode_interval_s = 30.0        # how often the decode worker runs (s)
min_buffer_s = 65.0             # don't decode until the buffer holds >= this (s)
# ledger_dir = "/var/lib/timestd/wwvb"   # default: <data_root>/wwvb

# --- Layer 4: Fusion source-pool feed (reaches the chrony-disciplining path) ---
# Leave OFF until a nighttime live-tap run validates the decode chain on real
# signal at this site.  When true, each accepted minute is written as an L1
# metrology row under <data_root>/phase2/WWVB_60 and the timestd-fusion service
# pools it with WWV/WWVH/BPM.  Requires [station] latitude/longitude (or
# grid_square) so the propagation delay can be computed.
feed_fusion = false
# Optional GPS-learned propagation-delay override (ms) + 1-sigma (ms).  Until a
# calibration pass supplies these, the nominal LF model is used and WWVB is
# graded MARGINAL (appropriately down-weighted in the combiner).
# learned_delay_ms = 4.6
# learned_sigma_ms = 0.8

[uploader]
enabled = true
protocol = "sftp"
upload_time = "00:30"
upload_timezone = "UTC"
max_retries = 5
retry_delay_seconds = 300
exponential_backoff = true
max_queue_size_gb = 100

[uploader.sftp]
host = "pswsnetwork.eng.ua.edu"
port = 22
ssh_key = "/home/timestd/.ssh/id_rsa_psws"
remote_base_path = "/"
bandwidth_limit_kbps = 0                # 0 = unlimited (default). Set a KB/s cap ONLY if the site has known bandwidth restrictions.
verify_after_upload = true
delete_after_upload = false
create_trigger_directory = true

[uploader.metadata]
include_extended_metadata = false       # true adds timing quality data

[logging]
level = "INFO"                          # DEBUG for troubleshooting
console_output = true
file_output = true

[monitoring]
enable_metrics = true

[web_ui]
port = 8000
refresh_interval = 60

[metrology]
# Set false to run in timing-only mode on resource-constrained hardware.
# When false, the following writers are skipped entirely (no disk I/O):
#   tick_phase (1 Hz Doppler/scintillation phase time series)
#   test_signal (WWV/WWVH ionospheric sounding at minutes 8 and 44)
#   detection_attempts (threshold-calibration diagnostics)
#   all_arrivals (multi-path propagation paths)
# The core timing pipeline (metrology_measurements, tick_timing, )
# is unaffected — Chrony discipline works identically with physics_products = false.
physics_products = true

# Set false to disable real-time ionospheric data fetching (WAM-IPE + GIRO).
# When false, the propagation model uses climatological fallback only.
# Chrony is still disciplined normally; only the propagation uncertainty budget
# is slightly degraded (inflated u_propagation_model_ms, typically <5 ms).
realtime_iono = true

# Decode the WWV BCD time code's leap-second warning (second 3) on the
# dedicated WWV channels (20/25 MHz) and publish it as leap_second_notice on
# that minute's WWV L1 row.  Fusion arms its leap-second Kalman hold from the
# notice as the month end approaches (docs/design/HOST_CLOCK_INTEGRITY.md).
# WWVB carries the same notice on its own row.  One 60 s decode per minute.
# bcd_leap_notice = true

[timing]
# `authority` and `rtp_expected_accuracy_ms` retired 2026-09-04
# (docs/design/RESIDUE_AUDIT_2026-09-04.md §3.5).  The station registers
# radiod's GPS_TIME/RTP_TIMESNAP pair and the Offset Judge supplies the
# correction; no mode switch remains.  `hf-timestd validate` warns on a
# config that still carries either key.

# === Authority manager ===
# Declared here so the section is visible surface, not a hidden key
# (split plan Phase 1: its historical absence kept T6 invisible on a
# fresh install).  All keys are optional; the manager runs with sane
# defaults when the section is empty.  Hosted by the fusion service —
# writes /run/hf-timestd/authority.json (schema v1, frozen).
[timing.authority_manager]

# === T2 — the WAN NTP witness (on by default, and it should stay on) ===
#
# T2 ranks BELOW T3: HF tick fusion resolves ~0.5-2 ms where WAN NTP over a
# domestic link sits at ~20 ms.  This block does not make the pool a time
# SOURCE.  It makes it a WITNESS — the only reading of UTC a T3-only station
# has that does not come from its own ADC.
#
# ⛔ AC0G-ND, 2026-09-03.  Shipped with this section EMPTY, so no probe was ever
# constructed, `t_level_witnesses` stayed `[]` on every tick, and §4.5's
# asymmetric T3↔T2 rule — "a gross T3-vs-WAN disagreement forces T3 down" —
# could not fire, because it is gated on `"T2" in witnesses`.  The station's
# RX888 was not governed by its GPSDO, so it sampled ~350 ppm fast; FUSE
# inherited the error, chrony followed FUSE with `trust` in force and walked the
# host clock TWELVE SECONDS off UTC.  Fusion reported itself locked and
# sub-millisecond throughout, because it locks a ONE-SECOND tick and so measures
# modulo one second.  Nothing else was watching.
#
# It needs no site-specific configuration — the matcher is "any server not
# claimed by T4" — and costs one `chronyc` call per tick.  Turn it off only if
# the host has no network time sources at all, and understand that doing so
# leaves Fusion policing itself.
[timing.authority_manager.t2]
enabled = true
# max_error_ms = 50.0    # optional last-sample error-margin ceiling; off by
#                        # default, since the cross-check layer already catches
#                        # a witness whose offset has drifted.

# === Host-clock integrity — the verdict beside the tier decision ===
#
# 2026-09-04, AC0G-B4 (governed RX888, T6 present): the host clock ran 11.6 s
# slow for thirteen hours while `chronyc tracking` showed it within 0.1 ms.
# FUSE carries `trust`, its product follows the host clock, so chrony had
# nothing to disagree with.  Three other measurements on the host saw it —
# the T2 pair check ("T6<->T2:11679ms ... :advisory"), the LB-1421 probe's
# host-versus-GPS gap (-12 s, returned as "no fix"), and gpsdo-monitor's PPS
# study (999.91 ms per second) — and none of them said so.  The same walk
# had hit AC0G-ND the day before (see the T2 note above); the ADC was blamed
# then, and the ADC was governed this time.
#
# The authority manager now folds those three into one `host_clock` block in
# authority.json (verdict ok / suspect / fault / unwitnessed) and logs
# CRITICAL on entry and once per `alarm_repeat_sec` while it holds.  Tier
# selection is untouched: the anchor was right both days.  This block only
# tunes the verdict; the witnesses register themselves.
# See docs/design/HOST_CLOCK_INTEGRITY.md.
[timing.authority_manager.host_clock]
# fault_ms = 1000.0          # a sysclock witness this far from an rtp-frame
#                            # active tier is a whole-second-class fault
#                            # (suspect starts at the pair's own bound)
# alarm_repeat_sec = 3600.0  # CRITICAL repeats this often while it holds
#
# The PPS-rate witness (gpsdo-monitor pps_study.period_ms_p50 -> ppm) is
# OFF by default.  Deployed on 2026-09-04 17:09Z it declared B4 SUSPECT at
# +83.7 ppm while the LAN stratum-1 held the host within 12 us; it had read
# -90 ppm during the runaway.  The study stamps DCD edges in Python after an
# ioctl wake and says of itself "not a metrology reference".  Enable only
# once someone has shown what the number tracks.
# rate_witness_enabled = false
# rate_suspect_ppm = 50.0    # when enabled: the study resolves ~17 ppm, so
#                            # do not go below that

# === Timing provenance — the station declares its plane and budget ===
# docs/design/TIMING_PROVENANCE_MODEL.md §3.2.  Both chains ship as defaults;
# override only the terms THIS station has measured.  A term states a value
# or a disposition; a Type A term carries measured_on.  `hf-timestd validate`
# checks each override.  The fusion service publishes the result at
# /run/hf-timestd/timing_chain.json for the GRAPE packager.
[timing.provenance]
# measurand_plane = "antenna_terminals"
# calibration_plane = "ts1_injection_point"
# traceability_qualification = "antenna-to-injector path not declared; receiver front end not characterised"
# [[timing.provenance.budget]]
# term = "antenna_to_injector"
# type = "B"
# correction_ns = 41000
# u_ns = 3000
# method = "12.3 m LMR-400 at 0.85 VF + preamp datasheet, 2026-09-10"

# The chrony refclock gate (core/chrony_refclock_gate.py; METROLOGY.md §4.6).
# Every authority tick it sets `chronyc selectopts <refid> ±noselect` on the
# FUSE refclock: offered (-noselect) while the active tier is T3 or T6,
# withdrawn (+noselect) otherwise.  Since 2026-09-04 (step 0.5 of the
# host-clock program, docs/design/HOST_CLOCK_INTEGRITY.md) it also withdraws
# FUSE while the host_clock verdict above reads suspect or fault, whatever
# the tier, and re-offers it only after `ok` has held for
# host_clock_clear_sec.  FUSE measures the clock chrony steers with it; the
# verdict comes from witnesses that do not.  Withdrawing FUSE lets chrony
# follow them instead of the walk.
#
# Off by default: `chronyc selectopts` needs chrony's command socket, and
# the timestd user cannot reach it on a stock install.  Membership in
# _chrony (which install.sh grants) does NOT help on Debian 13: the chrony
# unit keeps /run/chrony at 0700 and chronyd makes chronyd.sock owner-only,
# and chrony 4 takes privileged commands over that socket only.  The
# supported path is `sudo = true` here plus the two-command grant
# install.sh puts at /etc/sudoers.d/timestd-chrony-gate (refid FUSE is
# spelled out in that file; a different refid needs a matching edit).
# Then watch `chronyc sources` for the FUSE line flipping between
# `#-`/`#*` and `#?` on transitions, and `chronyc selectdata` for the N
# option on FUSE while withdrawn.
[timing.authority_manager.chrony_gate]
enabled = false
# sudo = true                       # run chronyc through `sudo -n` (see above)
# refid = "FUSE"                    # must match the refclock line in
#                                   # chrony-timestd-refclocks.conf
# dry_run = false                   # log the decision, call nothing
# withdraw_on_host_clock = true     # step 0.5; false restores the pure tier rule
# host_clock_clear_sec = 600.0      # `ok` must hold this long before FUSE returns


[timing.fusion_metrics]
enabled = true
# path = "/run/hf-timestd/fusion_metrics.json"  # default; override only for tests

# === Offset Judge (radiod epoch cross-check) ===
# Contract: docs/OFFSET-JUDGE-SPEC-2026-08-05.md.  The judge measures
# radiod's advertised (GPS_TIME, RTP_TIMESNAP) epoch against hf-timestd's
# own best UTC bench (P1: T4/T2 chrony, T3 FUSE), applies the measured
# offset to archive labels, and publishes the per-source offset trend to
# /run/hf-timestd/offset_judge.json.  With a co-located GPS source the
# offset reads ~0 — continuous health verification for free.  A wrong
# radiod epoch produces CORRECT labels plus a loudly-logged offset, not
# data loss.
[timing.offset_judge]
enabled = true
k = 5.0                  # violation bound: |offset| > k * sigma_tier (empirical sigma, spec §13.1)
tick_seconds = 10.0      # bench poll + publication cadence
sustain_window_s = 60.0  # violation must persist this long before the CRITICAL flag (spec §9.1)
# cross_bench_k = 5.0    # cross-bench consistency gate: a candidate bench is adopted
                         # only if it agrees with the trusted lower tier within
                         # cross_bench_k * sqrt(sigma_c^2 + sigma_l^2) over the whole
                         # advance window (docs/JUDGE-CROSS-BENCH-GATE-2026-08-05.md);
                         # failures publish cross_bench_conflict + shadow_residuals
# sigma_regression_margin = 2.0  # precision non-regression: a voluntary upgrade is
                         # refused (precision_hold published, WARNING) when
                         # sigma_candidate > sigma_incumbent * this margin — tier rank
                         # must not widen the k*sigma violation bound (spec §13.1);
                         # degrade-on-loss is never sigma-gated
# publish_path = "/run/hf-timestd/offset_judge.json"     # default
# fusion_status_path = "/run/hf-timestd/fusion_status.json"  # T3 bench input
# pair_step_threshold_s = 0.75  # radiod pair change beyond this fractures the segment (spec §5)

# --- Escalation ladder (spec §9 steps 2-3) ---
# Step 2: a violation (k*sigma offset OR sustained rate alarm) that persists
# alert_after_s emits an alert through the same channel as the freshness
# monitor (scripts/check-freshness-alert.sh): journald CRITICAL +
# `logger -t hf-timestd-alert -p user.crit` + optional mail to
# $TIMESTD_ALERT_EMAIL, at most one per alert_cooldown_s while it persists.
# The alert names the likely cause: constant lag => radiod epoch fault
# (restart clears it; labels are already judge-corrected), slope => clock
# rate disagreement (restart will NOT fix it).
# alert_after_s = 900.0
# alert_cooldown_s = 3600.0

# Step 3 (OPT-IN, site policy, spec §13.3): when enabled AND a violation
# sustains restart_request_after_s, the judge writes an atomic REQUEST
# artifact /run/hf-timestd/radiod-restart-request.json for the sigmond-side
# watchdog — the first and only component empowered to touch radiod.
# hf-timestd NEVER restarts radiod itself.  The request is withdrawn when
# the violation clears; re-requests are limited to one per
# restart_request_cooldown_s (6 h).  DEFAULT FALSE.
radiod_restart_request = false
# restart_request_after_s = 3600.0
# restart_request_cooldown_s = 21600.0

# === Service Profiles ===
# Controls which services run.  Profiles define a baseline set of services;
# per-service overrides let you add or remove individual services on top.
#
# Built-in profiles (from least to most services):
#   archive  — core-recorder only.  Raw IQ preservation, minimal resources.
#   rtp      — archive + monitoring timers.  Standard RTP mode
#              where radiod's GPSDO provides timing authority.
#   fusion   — rtp + metrology + l2-calibration + fusion + chrony-monitor.
#              GPS-denied mode: timing derived from HF broadcasts.
#   full     — fusion + physics + ionex-download + iono-reanalysis + vtec
#              (if gnss_vtec.enabled).  Full science + timing.
#
# The active profile sets the default for each service; per-service overrides
# take precedence.  For example, profile = "rtp" with metrology = true gives
# you the RTP baseline plus metrology for development/study.
[services]
profile = "rtp"

# Per-service overrides (true = force on, false = force off, omit = use profile)
# core_recorder = true        # Always on in every profile
# metrology = true            # Force metrology on (e.g., for study in RTP mode)
# l2_calibration = false      # Force off even if profile includes it
# fusion = true               # Multi-broadcast fusion → Chrony SHM
# physics = true              # L2/L3 ionospheric products
# vtec = false                # GNSS VTEC (also requires gnss_vtec.enabled)
# radiod_monitor = true       # Hardware health monitor
# grape_daily = true          # Daily GRAPE decimation + upload timer
# chrony_monitor = true       # Chrony timing authority watchdog
# ionex_download = true       # IONEX data fetch timer
# iono_reanalysis = true      # Ionospheric reanalysis timer
# pipeline_watchdog = true    # Pipeline health watchdog timer

# [timing.t6_pps] — T6 anchor inversion + L6 BPSK PPS chain-delay calibration.
# Legacy config name [timing.l6_pps] is still accepted at runtime (deprecated)
# for already-deployed hosts; migrate to [timing.t6_pps] at next service restart.
[timing.t6_pps]
# L6 BPSK PPS chain-delay calibration via local RF injector (WB6CXC / TS1).
# When enabled, core-recorder creates an IQ channel for the injected BPSK
# signal and measures end-to-end RF->ADC->DSP->RTP chain delay.
# The correction is applied to all channels' RTP-to-UTC mapping.
enabled = false
# The keys below are inert while enabled=false.  setup-station.sh's TS-1
# probe (scripts/ts1-probe.sh) fills enabled + frequency_hz automatically
# when an injector is detected: frequency_hz is the ALIAS of the TS-1 TX
# frequency under the ADC clock (TX 84.225 MHz -> 45.375 MHz at 129.6
# Msps, 19.425 MHz at 64.8 Msps).
frequency_hz = 0                  # injected (aliased) frequency; REQUIRED when enabled
sample_rate = 96000               # matched-filter calibrator channel SR
low_edge_hz = -25000
high_edge_hz = 25000
consecutive_required = 10         # valid edges before lock
edge_tolerance_samples = 30       # scale with sample_rate: 5 @16k, 30 @96k
use_magnitude_correlation = false # Method 2 Re-projection; Method 4 magnitude
# Coarse coherent fold (2026-09-05).  The per-edge detector integrates one
# half-second per edge and falls off a stochastic lock cliff near 58 dB-Hz;
# AC0G-B4's pilot sits at 48-57 dB-Hz after dark and the detector floods with
# noise edges.  Folding the matched-filter output over K seconds gains
# 10*log10(K) dB (17.8 dB at 60 s) and grants the same lock a run of
# consecutive edges would.  0 disables.  The fold then defines the reference
# the per-edge detector confirms against; a single edge no longer re-bases it.
coarse_fold_seconds = 60
# coarse_fold_min_snr = 8.0        # apex over residual sigma; noise folds to ~4-5
                                  # peak-pick FAILED twice (BPSK-PPS-DETECTION-
                                  # METHODS.md §4-5) — do not enable
description = "BPSK_PPS"
#
# chain_delay_calib_s = 0.0       # RETIRED under labeling_convention =
#                                 # "content" (the default): not applied,
#                                 # and validate stays quiet when unset.
#                                 # REQUIRED per site only with
#                                 # labeling_convention = "legacy".
#                                 # End-to-end RF delay: TS-1 BPSK modulator ->
#                                 # coax -> RX-888 ADC -> radiod DSP -> RTP.
#                                 # ASSERTED from this value and never derived
#                                 # (T6_ORIGIN_ASSERTION_DESIGN §5: deriving it
#                                 # from radiod's advertised wall clock made the
#                                 # correction a function of the mapping it was
#                                 # correcting — 58 different origins in one
#                                 # night on AC0G-B4).
#                                 # ⚠ Leaving it unset does NOT disable the
#                                 # correction, it asserts ZERO: the anchor pins
#                                 # to the integer second and every sample label
#                                 # is early by the whole chain delay.  AC0G-B4
#                                 # ran this way until 2026-08-15 and T6 read
#                                 # -16.098 ms against T4.
#                                 # HOW TO MEASURE (needs an independent bench,
#                                 # not radiod's own wall clock): with T6
#                                 # enabled and this key at 0, read
#                                 # shadow_residuals.T6.shadow_residual_ns from
#                                 # /run/hf-timestd/offset_judge.json over a few
#                                 # minutes.  Its magnitude IS the chain delay.
#                                 # Set this key to that value in seconds, then
#                                 # confirm the residual collapses toward zero.
#
# Calibrator tuning (the matched filter is the only calibrator since
# 2026-09-04; `use_matched_filter` is a retired key — RESIDUE_AUDIT §3.4):
# costas_loop_bw_hz = 1.0         # Loop bandwidth of the carrier-phase tracker
#                                 # (matched-filter only). Default 1.0; the GPSDO
#                                 # topology means residual carrier offset is
#                                 # sub-Hz, so a slow loop is plenty.
# use_magnitude_correlation = false
#                                 # When true, the matched filter runs on the
#                                 # COMPLEX IQ signal and peak-picks on |y|.
#                                 # The Costas loop is still computed (for
#                                 # observability) but no longer gates edge
#                                 # acceptance — the magnitude peak is
#                                 # rotation-invariant by construction.
#                                 # Eliminates the carrier-recovery instability
#                                 # and per-restart chain_delay disambiguation
#                                 # drift documented in
#                                 # docs/HF-PPS-CHRONY-TUNING.md §5.2.  Default
#                                 # false to keep deployed Costas behaviour
#                                 # until explicit opt-in; recommended TRUE
#                                 # for any GPSDO-fed TS1 installation.
#
# Channel filter overrides (require ka9q-python ≥ 3.11):
# low_edge_hz = -25000            # Channel filter low edge (Hz, relative to center).
# high_edge_hz = 25000            # Channel filter high edge. Recommended ±25 kHz with
#                                 # the matched filter: σ_t scales as 1/B for a
#                                 # band-limited polarity-flip step, so wider is
#                                 # better up to the receiver / aliasing limit.
#                                 # Omit (or None) to use the iq preset's ±5 kHz default.
#
# --- T6 anchor inversion (docs/design/T6_ANCHOR_INVERSION_DESIGN.md) ---
# fine_stage_enabled = true        # coherent zero-crossing fine stage + T6 anchor authority
# fine_fold_seconds = 30           # coherent fold length K (seconds)
# delay_budget_ns = 200            # TS-1 modulator path only.  DEFAULT 200 ns.
#                                  # Source: P. Elliott (WB6CXC), who designed
#                                  # the TS-1 — under 200 ns in standard
#                                  # injector mode (2026-08-30).
#                                  # ⛔ This default read 10000 until 2026-08-30.
#                                  # That figure originated as THIS COMMENT,
#                                  # was then cited back as vendor
#                                  # documentation, and over-corrected every
#                                  # T6 anchor by ~9.8 µs.
#                                  # ⚡ A site that measures its own plumbing
#                                  # SHOULD set this explicitly.  The antenna-
#                                  # to-injector run (feed, preamp, filter)
#                                  # enters with the OPPOSITE sign, because the
#                                  # injected reference never traverses it:
#                                  #     delay_budget_ns = d_mod − d_ant_to_inj
#                                  # The injector-to-receiver coax cancels — it
#                                  # is common to signal and reference.
#                                  # See docs/design/TIMING_PROVENANCE_MODEL.md
#                                  # §4.5.
#                                  # HARD BOUND ±1 ms — the guard exists to stop
#                                  # timestamp error being absorbed here, so do
#                                  # NOT widen it; the radiod filter group delay
#                                  # has its own term below.
# labeling_convention = "content"  # What a T6 label MEANS.
#                                  #   "content" (default) — the antenna
#                                  #     instant.  Only the µs-class analog
#                                  #     path (delay_budget_ns) is part of the
#                                  #     label; USB transfer, the FFT,
#                                  #     filtering and scheduling are pipeline
#                                  #     LATENCY measured live by the judge,
#                                  #     not folded into the anchor.
#                                  #   "legacy" — the pre-2026-08-24
#                                  #     arithmetic, which applied
#                                  #     filter_group_delay_ns below.  Kept so
#                                  #     a site can revert in one line.
#                                  # See docs/design/CONTENT_TIME_LABELING_CONVENTION.md
# filter_group_delay_ns = 0        # RETIRED under the content convention —
#                                  # not applied, and validate warns if set.
#                                  # Applies only with labeling_convention =
#                                  # "legacy", where it is the DOMINANT term,
#                                  # milliseconds not µs.  AC0G-B4
#                                  # measured 16_618_000 (16.618 ms) at 96 kHz /
#                                  # ±25 kHz edges on 2026-08-15.  HARD BOUND
#                                  # ±250 ms (reaches ~150 ms at the narrowest
#                                  # filter widths).
#                                  # ⚠ Site-specific: it follows the CHANNEL
#                                  # FILTER, so re-measure if low_edge_hz /
#                                  # high_edge_hz / sample_rate change.
#                                  # ⚠ While the T6 authority is AUTHORITATIVE
#                                  # this is the knob that matters, NOT
#                                  # chain_delay_calib_s — the fine-stage edge
#                                  # defines the anchor and the coarse
#                                  # chain_delay becomes a diagnostic.
#                                  # HOW TO MEASURE: leave at 0, then read
#                                  # shadow_residuals.T6 from
#                                  # /run/hf-timestd/offset_judge.json over
#                                  # ~15 min; its magnitude is this value.
# edge_period_tolerance_ns = 5000  # invariant: successive edges advance by exactly 1 s
# fine_coarse_max_ms = 5           # invariant: |fine − MF apex| bound
# degraded_unlock_after_sec = 600  # DEGRADED longer than this → UNLOCKED

[storage]
# Storage backend. SQLite is the SOLE backend as of v7.0 — the HDF5
# backend was deleted in the Phase-4 migration (see
# docs/HDF5-TO-SQLITE-MIGRATION.md). All data products are written to and
# read from the single SQLite database at sqlite_path (one table per
# product, distinguished by a `channel` column).
#
# The write_hdf5 / write_sqlite / read_sqlite knobs below are RETAINED
# FOR BACKWARD COMPATIBILITY ONLY and are now no-ops:
# make_data_product_writer() / make_data_product_reader() use SQLite
# unconditionally, regardless of their values. They will be removed in a
# future release.
write_hdf5 = false      # no-op (HDF5 backend removed at v7.0)
write_sqlite = true     # no-op (SQLite is always written)
read_sqlite = true      # no-op (SQLite is always read)
sqlite_path = "/var/lib/timestd/phase2/timestd.db"

[gnss_vtec]
enabled = false                         # Set to true if you have a GNSS receiver
host = "<YOUR_GNSS_HOST>"               # IP of GNSS receiver or ser2net bridge
port = 9000                             # GNSS data stream port (UBX protocol)
save_csv = true
csv_path = "data/gnss_vtec.csv"
save_hdf5 = true
hdf5_path = "data/gnss_vtec"
