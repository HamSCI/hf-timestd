# /etc/hf-timestd/events.toml - event-response keeper (hf-timestd events run)
# The timestd-events.timer is enabled by install.sh only when this file exists.

station_id  = "AC0G-B4"
remote      = "wsprdaemon@192.168.1.164"
remote_root = "/srv/wd_data/events"
ssh_key     = "/var/lib/timestd/.ssh/events_ed25519"
staging     = "/var/lib/timestd/events-staging"
raw_root    = "/var/lib/timestd/raw_buffer"
settle_minutes = 15     # wait this long after a window closes before cutting it
bwlimit_kbps = 0        # 0 = no rsync bandwidth limit

# Optional: cut only these channels.  Default: every directory under raw_root.
# channels = ["WWV_2_5", "WWV_5"]
